# Copier vers .env.local et remplir.

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL="https://VOTRE_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...anon"
# Optionnel (nouveau format clés) :
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Clé service_role (Settings → API) — serveur uniquement, pour créer les comptes équipe.
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role"

# --- DATABASE (Prisma) : Session pooler ---
# Connect → Method : Session pooling → URI
DATABASE_URL="postgresql://postgres.votre_ref:MOT_DE_PASSE@aws-0-VOTRE_REGION.pooler.supabase.com:5432/postgres"

# Après avoir recréé le profil User (auth) :
#   exécuter prisma/supabase-auth-user-profile.sql dans Supabase → SQL Editor

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron escalade demandes (Vercel Cron → Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="generer-avec-openssl-rand-base64-32"

# Optionnel cookie Secure :
# COOKIE_SECURE="false"

# SERVER_ACTIONS_ALLOWED_ORIGINS="mondomaine.fr,www.mondomaine.fr"
# SERVER_ACTIONS_STRICT_LOCAL="1"
