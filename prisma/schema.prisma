generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  role         String      @default("OWNER")
  employerId   String?
  employer     User?       @relation("StaffEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  staffMembers User[]      @relation("StaffEmployer")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  events       Event[]
  checklists   Checklist[]
  shoppingLists ShoppingList[]
  staffEventAccess StaffEventAccess[]
  staffTasksCreated StaffTask[] @relation("StaffTaskCreator")
  staffTasksAssigned StaffTask[] @relation("StaffTaskAssignee")

  @@index([employerId])
  @@index([role])
}

model Checklist {
  id        String   @id @default(cuid())
  name      String
  blocks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Event {
  id                  String         @id @default(cuid())
  publicSlug          String         @unique
  name                String
  venue               String         @default("")
  startsAt            DateTime?
  endsAt              DateTime?
  instructions        String         @default("")
  instructionsBlocks  Json?
  menuHidden          Boolean        @default(false)
  status              String         @default("LIVE")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  ownerId             String
  owner               User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems           MenuItem[]
  requests            GuestRequest[]
  accessories         EventAccessory[]
  staffAccess         StaffEventAccess[]
  staffTasks          StaffTask[]
  shoppingLists       ShoppingList[]

  @@index([ownerId])
  @@index([status])
}

model StaffEventAccess {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model StaffTask {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User     @relation("StaffTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?    @relation("StaffTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  title        String
  note         String   @default("")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([eventId])
  @@index([assignedToId])
  @@index([status])
}

model ShoppingList {
  id        String   @id @default(cuid())
  name      String
  items     Json
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sentAt    DateTime?
  sentTo    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([eventId])
}

model EventAccessory {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int      @default(1)
  notes     String   @default("")
  sortOrder Int      @default(0)

  @@index([eventId])
}

model MenuItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  outOfStock  Boolean  @default(false)
  hidden      Boolean  @default(false)

  @@index([eventId])
}

model GuestRequest {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableNumber   String
  tableLocation String   @default("")
  type          String
  message       String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([status])
}
